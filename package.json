{
  "name": "autoprint",
  "version": "1.1.0",
  "description": "Electron-based auto print service with web interface",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "build": "electron-builder --win nsis --x64",
    "build:installer": "electron-builder --win nsis --x64"
  },
  "keywords": [
    "electron",
    "print",
    "pdf"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "express": "^5.2.1",
    "multer": "^2.4.0",
    "node-windows": "^1.0.0-beta.8",
    "pdf-to-printer": "^5.8.1"
  },
  "build": {
    "appId": "com.autoprint.app",
    "productName": "AutoPrint",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!node_modules/.cache/**"
    ],
    "asar": false,
    "extraResources": [
      {
        "from": "public",
        "to": "public",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "AutoPrint-Setup-${version}.exe",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  },
  "allowScripts": {
    "electron@44.4.1": true
  }
}
